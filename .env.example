# Copia este archivo a .env y cambia la clave. .env no se sube a Git.
POSTGRES_DB=partepro
POSTGRES_USER=partepro
POSTGRES_PASSWORD=cambia-esta-clave

# Lo que lee el backend (los mismos valores, en el formato de Spring).
DB_URL=jdbc:postgresql://localhost:5432/partepro
DB_USER=partepro
DB_PASSWORD=cambia-esta-clave
